# --- Supabase (project: kbcinsjhfshbzywmuute) ---
NEXT_PUBLIC_SUPABASE_URL=https://kbcinsjhfshbzywmuute.supabase.co
# Dashboard → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server only, never expose to the client
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM provider ---
# LLM_PROVIDER=anthropic (default) or openai-compat (any OpenAI-compatible API).
LLM_PROVIDER=openai-compat

# --- Production (paid, cheap): Gemini Flash-Lite ---
# Picked over Groq's free llama models (see below) and GPT-5 nano/mini after
# comparing per-eval cost, judgment quality, and integration risk in July
# 2026: Gemini's OpenAI-compat endpoint takes standard temperature/max_tokens
# with none of GPT-5's reasoning-model param quirks, and — unlike Groq's free
# tier, which is what forced the batching/backoff/quota-message machinery in
# anthropic.ts — a paid key removes the per-minute token ceilings that caused
# real evaluation failures during testing.
#
# Every call — judge, synth, and the cheap placement/prose triage — runs on
# Flash-Lite. The standard Flash tier (judging-grade reasoning, ~5x the
# input cost / ~3x the output cost) is available by pointing LLM_MODEL_JUDGE
# and LLM_MODEL_SYNTH at gemini-3.6-flash instead, if Flash-Lite's judgment
# quality on head-to-head comparisons isn't holding up.
#
# 1. Create a key at https://aistudio.google.com/apikey and enable billing
#    (the free tier caps at ~20 requests/day — one evaluation makes ~8-21
#    calls depending on JUDGE_BATCH_SIZE, so it can't finish free).
# 2. Fill these in. Verify current model IDs/pricing at
#    https://ai.google.dev/gemini-api/docs/pricing — this tier moves fast
#    (three Flash releases between Gemini 3 and 3.6 in the first half of 2026).
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL_JUDGE=gemini-3.5-flash-lite
LLM_MODEL_SYNTH=gemini-3.5-flash-lite
LLM_MODEL_CHEAP=gemini-3.5-flash-lite
LLM_REASONING_EFFORT=low   # Flash-Lite thinks before answering; keep it cheap

# --- Free provider for testing (Groq, free tier — no card, no billing) ---
# Swap the four LLM_* vars above for these to test with zero cost. This is
# also what the dev bar's "Fast"/"Full" engine toggle presets were built
# against (see LLM_MODEL_FAST below) — expect its per-minute token caps to
# surface real failures a paid tier won't (that's what shook out the
# defensive tier/score validation and structured-output self-healing in
# src/lib/engine/judge.ts and src/lib/anthropic.ts).
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_API_KEY=<console.groq.com/keys>
#   LLM_MODEL_JUDGE=llama-3.3-70b-versatile
#   LLM_MODEL_SYNTH=llama-3.3-70b-versatile
#   LLM_MODEL_CHEAP=llama-3.1-8b-instant
#
# Groq free tier is ~100k tokens/DAY on llama-3.3-70b — roughly 10 free-tier
# or 5 Plus evaluations. If you exhaust it mid-testing, either point
# LLM_MODEL_JUDGE at llama-3.1-8b-instant (its own, larger daily bucket) or
# set MOCK_JUDGE=1 below to exercise the whole app with no API at all.

# --- Evaluation cost / reliability tradeoff ---
# Matches judged per LLM call. Batching sends the system prompt, the schema,
# and the user's essay ONCE per batch instead of once per match — ~5.6x fewer
# tokens, which is what makes free tiers viable. Verdicts in a batch share one
# reading, so their noise is correlated; set to 1 for fully independent matches
# (with order-swap) on a paid tier.
JUDGE_BATCH_SIZE=5
# Only applies when JUDGE_BATCH_SIZE=1: use one reading per match instead of
# the two-reading order-swap check.
JUDGE_SINGLE_READING=

# --- Testing ---
# Renders the top-right dev bar: a Free/Plus plan toggle and an engine toggle
# (Mock = zero cost, Fast = LLM_MODEL_FAST, Full = LLM_MODEL_JUDGE).
# The engine choice is stored per-browser in a cookie, so you can switch
# without redeploying. MUST be removed before charging real customers — with
# it set, any signed-in user can grant themselves Plus.
ALLOW_PLAN_TOGGLE=1
# Model used by the dev bar's "Fast" preset — defaults to the cheap tier of
# whichever provider is configured above (Flash-Lite for Gemini, 8b-instant
# for Groq).
LLM_MODEL_FAST=gemini-3.5-flash-lite

# --- Anthropic (highest judgment quality, priciest) ---
# Set LLM_PROVIDER=anthropic to use these instead of the openai-compat
# provider above. claude-haiku-4-5 alone (as LLM_MODEL_JUDGE) is a reasonable
# middle ground if Gemini's judgment quality isn't cutting it but full Opus
# is overkill.
ANTHROPIC_API_KEY=
# claude-opus-4-8 = best judgment; claude-haiku-4-5 = fast & cheap.
ANTHROPIC_MODEL_JUDGE=claude-opus-4-8
ANTHROPIC_MODEL_SYNTH=claude-opus-4-8

# Set to 1 to run the full product with a deterministic mock judge (no API at all)
MOCK_JUDGE=

# --- Stripe ---
STRIPE_SECRET_KEY=
# From: npx tsx scripts/setup-stripe.ts (creates the $12/mo Margin Plus price)
STRIPE_PRICE_ID=
# From: Stripe dashboard → Webhooks → endpoint https://<your-domain>/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
