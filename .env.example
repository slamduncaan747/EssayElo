# --- Supabase (project: kbcinsjhfshbzywmuute) ---
NEXT_PUBLIC_SUPABASE_URL=https://kbcinsjhfshbzywmuute.supabase.co
# Dashboard → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server only, never expose to the client
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM provider ---
# LLM_PROVIDER=anthropic (default) or openai-compat (any OpenAI-compatible API).
LLM_PROVIDER=openai-compat

# --- Free provider for testing (recommended: Groq, free tier) ---
# 1. Create a key at https://console.groq.com/keys (free, no card)
# 2. Fill these in:
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL_JUDGE=llama-3.3-70b-versatile
LLM_MODEL_SYNTH=llama-3.3-70b-versatile
# Placement (a 3-way triage) and prose (one score) don't need the judging
# model. Groq meters each model separately, so pointing these at a small model
# both saves the judge's daily budget and draws from a different quota bucket.
LLM_MODEL_CHEAP=llama-3.1-8b-instant
#
# Groq free tier is ~100k tokens/DAY on llama-3.3-70b — roughly 10 free-tier
# or 5 Plus evaluations. If you exhaust it mid-testing, either point
# LLM_MODEL_JUDGE at llama-3.1-8b-instant (its own, larger daily bucket) or
# set MOCK_JUDGE=1 below to exercise the whole app with no API at all.

# --- Evaluation cost / reliability tradeoff ---
# Matches judged per LLM call. Batching sends the system prompt, the schema,
# and the user's essay ONCE per batch instead of once per match — ~5.6x fewer
# tokens, which is what makes free tiers viable. Verdicts in a batch share one
# reading, so their noise is correlated; set to 1 for fully independent matches
# (with order-swap) on a paid tier.
JUDGE_BATCH_SIZE=5
# Only applies when JUDGE_BATCH_SIZE=1: use one reading per match instead of
# the two-reading order-swap check.
JUDGE_SINGLE_READING=

# --- Testing ---
# Renders a Free/Plus toggle in the top right and enables /api/dev/plan.
# MUST be removed before charging real customers — with it set, any signed-in
# user can grant themselves Plus.
ALLOW_PLAN_TOGGLE=1
#
# NOTE: Google Gemini's FREE tier caps gemini-flash-latest at ~20 requests/DAY,
# and one evaluation makes ~21 calls — so the free Gemini tier can't finish a
# single evaluation. Use Groq (above) for free testing, or enable billing on the
# Gemini key. Gemini config, if you do enable billing:
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   LLM_API_KEY=<AI Studio key from https://aistudio.google.com/apikey>
#   LLM_MODEL_JUDGE=gemini-flash-latest
#   LLM_MODEL_SYNTH=gemini-flash-latest
#   LLM_REASONING_EFFORT=low   # gemini flash thinks before answering; keep it cheap

# --- Anthropic (production judgment quality) ---
# Set LLM_PROVIDER=anthropic to use these instead of the free provider above.
ANTHROPIC_API_KEY=
# claude-opus-4-8 = best judgment; claude-haiku-4-5 = fast & cheap.
ANTHROPIC_MODEL_JUDGE=claude-opus-4-8
ANTHROPIC_MODEL_SYNTH=claude-opus-4-8

# Set to 1 to run the full product with a deterministic mock judge (no API at all)
MOCK_JUDGE=

# --- Stripe ---
STRIPE_SECRET_KEY=
# From: npx tsx scripts/setup-stripe.ts (creates the $12/mo Margin Plus price)
STRIPE_PRICE_ID=
# From: Stripe dashboard → Webhooks → endpoint https://<your-domain>/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
