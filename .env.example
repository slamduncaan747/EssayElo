# --- Supabase (project: kbcinsjhfshbzywmuute) ---
NEXT_PUBLIC_SUPABASE_URL=https://kbcinsjhfshbzywmuute.supabase.co
# Dashboard → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server only, never expose to the client
SUPABASE_SERVICE_ROLE_KEY=

# --- Testing ---
# Renders the top-right dev bar: a Free/Plus plan toggle, so the paywall UI
# can be exercised without going through Stripe. MUST be unset before
# charging real customers — with it set, any signed-in user can grant
# themselves Plus for free.
ALLOW_PLAN_TOGGLE=1

# --- Stripe ---
STRIPE_SECRET_KEY=
# From: npx tsx scripts/setup-stripe.ts (creates the $12/mo Margin Plus price)
STRIPE_PRICE_ID=
# From: Stripe dashboard → Webhooks → endpoint https://<your-domain>/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Written coaching ---
# Server-only. Scoring happens in the Cloud Run evaluator; the written
# feedback (reader snapshot, dimension evidence, strengths, revision
# priorities, Draft 2 plan) is generated separately in
# src/lib/feedback/generate.ts. Without this key, evaluations still score
# but land in the "feedback needs a retry" state.
#
# Same OpenAI account as the evaluator service — but the evaluator's copy
# lives in Cloud Run Secret Manager, so the value still has to be set here
# too for the Next app to use it.
OPENAI_API_KEY=

# The coaching model. Deliberately NOT the evaluator's gpt-5-nano — a small
# model writes generic feedback no matter how good the prompt.
FEEDBACK_MODEL=gpt-5
FEEDBACK_REASONING_EFFORT=high
# Optional: repoint at any OpenAI-compatible endpoint.
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Evaluation engine ---
# Server-only — never prefix these with NEXT_PUBLIC_. The browser never
# talks to Cloud Run directly; requests go through
# /api/evaluations/[id]/run, which attaches the key server-side.
EVALUATOR_API_URL=https://essay-evaluator-api-bjkhkpcs3q-uc.a.run.app
EVALUATOR_API_KEY=

# By default, non-production environments run the live evaluation UI off a
# scripted client-side fixture (src/lib/evaluation/fixtures.ts) so the
# experience can be built and demoed without API credentials. Set this to
# "api" in a non-production env to exercise the real Cloud Run proxy
# instead (still called with mock:true — see src/lib/evaluation/serverMock.ts).
# Production always uses "api" with mock:false, regardless of this value.
EVAL_TRANSPORT=fixture
