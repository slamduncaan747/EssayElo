# --- Supabase (project: kbcinsjhfshbzywmuute) ---
NEXT_PUBLIC_SUPABASE_URL=https://kbcinsjhfshbzywmuute.supabase.co
# Dashboard → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server only, never expose to the client
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM provider ---
# LLM_PROVIDER=anthropic (default) or openai-compat (any OpenAI-compatible API).
LLM_PROVIDER=openai-compat

# --- Free provider for testing (recommended: Groq, free tier) ---
# 1. Create a key at https://console.groq.com/keys (free, no card)
# 2. Fill these in:
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL_JUDGE=llama-3.3-70b-versatile
LLM_MODEL_SYNTH=llama-3.3-70b-versatile
# Free tiers cap tokens-per-minute. Set this to 1 so each match is ONE judge
# call instead of two (order-swap off) — halves token usage. Recommended on
# any free tier; unset it on a paid tier to restore full order-swap reliability.
JUDGE_SINGLE_READING=1
#
# NOTE: Google Gemini's FREE tier caps gemini-flash-latest at ~20 requests/DAY,
# and one evaluation makes ~21 calls — so the free Gemini tier can't finish a
# single evaluation. Use Groq (above) for free testing, or enable billing on the
# Gemini key. Gemini config, if you do enable billing:
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   LLM_API_KEY=<AI Studio key from https://aistudio.google.com/apikey>
#   LLM_MODEL_JUDGE=gemini-flash-latest
#   LLM_MODEL_SYNTH=gemini-flash-latest
#   LLM_REASONING_EFFORT=low   # gemini flash thinks before answering; keep it cheap

# --- Anthropic (production judgment quality) ---
# Set LLM_PROVIDER=anthropic to use these instead of the free provider above.
ANTHROPIC_API_KEY=
# claude-opus-4-8 = best judgment; claude-haiku-4-5 = fast & cheap.
ANTHROPIC_MODEL_JUDGE=claude-opus-4-8
ANTHROPIC_MODEL_SYNTH=claude-opus-4-8

# Set to 1 to run the full product with a deterministic mock judge (no API at all)
MOCK_JUDGE=

# --- Stripe ---
STRIPE_SECRET_KEY=
# From: npx tsx scripts/setup-stripe.ts (creates the $12/mo Margin Plus price)
STRIPE_PRICE_ID=
# From: Stripe dashboard → Webhooks → endpoint https://<your-domain>/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
