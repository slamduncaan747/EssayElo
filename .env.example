# --- Supabase (project: margin / othgmblwoxeemzltjdfn) ---
NEXT_PUBLIC_SUPABASE_URL=https://othgmblwoxeemzltjdfn.supabase.co
# Dashboard → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server only, never expose to the client
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic ---
ANTHROPIC_API_KEY=
# Judge runs 2×(10–25) calls per evaluation — this is the main cost/latency
# lever. claude-opus-4-8 for maximum judgment quality; claude-haiku-4-5 for
# fast, cheap evaluations.
ANTHROPIC_MODEL_JUDGE=claude-opus-4-8
ANTHROPIC_MODEL_SYNTH=claude-opus-4-8
# Set to 1 to run the full product with a deterministic mock judge (no API cost)
MOCK_JUDGE=

# --- Stripe ---
STRIPE_SECRET_KEY=
# From: npx tsx scripts/setup-stripe.ts (creates the $12/mo Margin Plus price)
STRIPE_PRICE_ID=
# From: Stripe dashboard → Webhooks → endpoint https://<your-domain>/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
